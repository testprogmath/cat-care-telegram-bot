#!/usr/bin/env bash
set -euo pipefail

tag="${SSH_ORIGINAL_COMMAND:-${1:-}}"
if [[ ! "$tag" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "usage: redeploy vX.Y.Z" >&2
  exit 2
fi

cd "$(dirname "$0")/.."
git fetch --quiet --tags --force origin
commit=$(git rev-parse --verify --quiet "refs/tags/$tag^{commit}") || {
  echo "no such tag: $tag" >&2
  exit 1
}
git -c advice.detachedHead=false checkout --quiet --force --detach "$commit"
docker compose build --pull
docker compose up -d
docker compose ps
echo "Deployed $tag ($(git rev-parse --short HEAD))"
